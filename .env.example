# Copia questo file in .env.local solo se vuoi sovrascrivere i valori di default.
# Nessun segreto va committato nel repository.

NEXT_PUBLIC_SITE_URL=https://tiberiusmc.it
NEXT_PUBLIC_SERVER_IP=play.tiberiusmc.it
NEXT_PUBLIC_MC_VERSION=
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/uVwhyjV8G
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/tiberiusmc
NEXT_PUBLIC_STORE_URL=
NEXT_PUBLIC_MAP_URL=

# Footer: ogni riga compare solo se il valore è impostato.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_COMPANY_INFO=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_COOKIE_URL=

# Forum (vedi docs/FORUM.md). Senza questi valori il forum mostra "non ancora attivo".
# I segreti vanno SOLO nelle variabili d'ambiente di Vercel, mai nel repository o in chat.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Facoltativo: di default https://<dominio>/api/auth/discord/callback
DISCORD_REDIRECT_URI=
# Segreto condiviso con il plugin /collega (almeno 32 caratteri casuali)
MC_LINK_SECRET=
# ID Discord degli amministratori iniziali, separati da virgola
FORUM_OWNER_DISCORD_IDS=
